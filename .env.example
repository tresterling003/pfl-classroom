# ───────────────────────────────────────────────────────────────────────────
# PFL Classroom — environment settings
# Copy this file to ".env.local" for local use. On Vercel, add these under
# Project → Settings → Environment Variables. NEVER commit real values.
# ───────────────────────────────────────────────────────────────────────────

# Database (REQUIRED in production).
# Neon (recommended, free tier): use the "pooled" connection string.
# Leave EMPTY for local development: an embedded database is created in ./.data
DATABASE_URL=

# First-run setup code (REQUIRED in production).
# Make up a long random phrase. You type it once on the /setup page to create
# your teacher account, so strangers can't claim your new site first.
TEACHER_SETUP_CODE=

# ── Optional: AI-assisted short-answer grading (costs money per answer) ──
# Leave AI_PROVIDER empty to use the free rubric grader (scores marked provisional).
AI_PROVIDER=
# Your Anthropic API key (server-side only — students can never see it).
ANTHROPIC_API_KEY=
# Model to use. Default: claude-opus-5-5. For lower cost, try claude-haiku-5-5.
AI_MODEL=

# ── Optional tuning ──
# Max database connections per server instance (default 5).
DB_POOL_MAX=
